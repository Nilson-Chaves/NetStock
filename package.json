{
  "name": "netstock",
  "version": "1.0.0",
  "description": "Sistema de Controle de Ativos e Estoque de TI - NetStock",
  "main": "js/main.js",
  "type": "module",
  "scripts": {
    "api": "json-server db.json --port 3000 --host 0.0.0.0",
    "web": "http-server -p 5500 --host 0.0.0.0",
    "start": "concurrently \"npm run api\" \"npm run web\""
  },
  "devDependencies": {
    "concurrently": "8.2.2",
    "http-server": "14.1.1",
    "json-server": "0.17.4"
  }
}
